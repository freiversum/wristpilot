project.manifest = manifest-beta.xml

# Beta build: same as release, alternate app id for private store testing.
# MIP devices (fenix 7 Pro family): four bold fields, 40 px icon (resources/).
base.sourcePath = source;source-build;source-style-mip

# AMOLED devices: coloured discs next to the buttons, larger launcher icon.
fenix843mm.sourcePath = source;source-build;source-style-amoled
fenix843mm.resourcePath = $(fenix843mm.resourcePath);resources-icon60
